:root {
    --ink: #ece4d0;
    --ink-dim: #b3a78f;
    --ink-faint: #7d735f;
    --gold: #d9ad55;
    --gold-bright: #f3d283;
    --gold-deep: #8a6526;
    --panel: rgba(22, 18, 13, 0.93);
    --panel-2: rgba(40, 33, 24, 0.96);
    --edge: #6e532a;
    --edge-dark: #33271a;
    --side1: #b5372b;
    --side2: #2f63a8;
    --hp: #79b356;
    --hp-low: #c44b31;
    --morale: #d8b545;
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--ink);
    font-size: 13px;
}

.hidden {
    display: none;
}

.panel {
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--edge);
    border-radius: 6px;
}

/* ── верх: ход, фаза, «Ход!», скорость, силы сторон ── */
.top-bar {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    align-items: center;
}

.top-box {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px 6px 16px;
}

.turn-block {
    align-items: center;
    margin-right: 16px;
}

.turn-caption {
    font-size: 10px;
    color: var(--ink-dim);
    letter-spacing: 2px;
}

.turn-number {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--gold-bright);
}

.phase-block {
    width: 230px;
    margin-right: 14px;
}

.phase-text {
    font-size: 14px;
    -unity-font-style: bold;
}

.phase-sub {
    font-size: 11px;
    color: var(--ink-dim);
}

.progress {
    height: 5px;
    margin-top: 5px;
    background-color: #15110b;
    border-radius: 2px;
}

.progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--gold);
    border-radius: 2px;
}

.go-button {
    width: 120px;
    height: 46px;
    margin: 0;
    padding: 0;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: #2a1d0a;
    background-color: var(--gold);
    border-width: 2px;
    border-color: var(--gold-bright);
    border-radius: 5px;
    transition-duration: 0.12s;
}

.go-button:hover {
    background-color: var(--gold-bright);
}

.go-button:active {
    background-color: var(--gold-deep);
}

.speed-group {
    flex-direction: row;
}

.speed-btn {
    width: 40px;
    height: 34px;
    margin: 0 2px;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--ink-dim);
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 4px;
}

.speed-btn:hover {
    border-color: var(--gold-deep);
    color: var(--ink);
}

.speed-btn.is-on {
    color: #2a1d0a;
    background-color: var(--gold);
    border-color: var(--gold-bright);
}

.power {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding: 3px 10px;
}

.power-name {
    font-size: 12px;
    -unity-font-style: bold;
    width: 110px;
}

.power-name.right {
    -unity-text-align: middle-right;
}

.power-bar {
    flex-direction: row;
    width: 300px;
    height: 10px;
    margin: 0 8px;
    border-width: 1px;
    border-color: var(--edge-dark);
}

.power-seg {
    height: 100%;
}

.power-seg.side-1 {
    background-color: var(--side1);
}

.power-seg.side-2 {
    background-color: var(--side2);
}

/* ── справа: журнал ── */
.log-panel {
    position: absolute;
    right: 10px;
    top: 104px;
    width: 340px;
    max-height: 46%;
    padding: 8px 10px;
    overflow: hidden;
}

.log-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    margin-bottom: 4px;
}

.log-line {
    font-size: 11px;
    color: var(--ink-dim);
    white-space: normal;
    margin-bottom: 3px;
}

.log-panel.is-collapsed > .log-line {
    display: none;
}

/* ── слева внизу: выбранный отряд ── */
.detail {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 300px;
    padding: 10px 12px;
}

.detail-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.detail-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    color: var(--gold-bright);
}

.detail-name {
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
}

.detail-type {
    font-size: 11px;
    color: var(--ink-dim);
}

.detail-row {
    flex-direction: row;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-color: var(--edge-dark);
    padding: 2px 0;
}

.detail-key {
    color: var(--ink-dim);
}

.detail-val {
    -unity-font-style: bold;
}

.detail-order {
    margin-top: 8px;
    color: var(--gold-bright);
    white-space: normal;
}

.detail-plan {
    color: var(--ink-dim);
    font-size: 12px;
    white-space: normal;
}

.detail-plan.is-bad {
    color: #e0806a;
}

.detail-plan.is-good {
    color: #a6d48a;
}

/* ── низ: приказы, стороны, карточки ── */
.bottom-dock {
    position: absolute;
    left: 320px;
    right: 360px;
    bottom: 8px;
    align-items: center;
}

.orders-bar {
    flex-direction: row;
    padding: 4px;
    margin-bottom: 6px;
}

.order-btn {
    width: 66px;
    height: 58px;
    margin: 0 2px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 4px;
    transition-duration: 0.1s;
}

.order-btn:hover {
    background-color: #3d3223;
    border-color: var(--gold-deep);
}

.order-btn.is-on {
    background-color: #4a3a22;
    border-color: var(--gold);
}

.order-btn.is-off {
    opacity: 0.35;
}

.order-icon {
    width: 26px;
    height: 26px;
    color: var(--ink);
}

.order-label {
    font-size: 10px;
    color: var(--ink-dim);
    margin-top: 2px;
}

.order-key {
    position: absolute;
    top: 2px;
    right: 4px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--gold);
}

.side-tabs {
    flex-direction: row;
    align-self: center;
}

.side-tab {
    padding: 4px 16px;
    margin: 0 2px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--ink-faint);
    background-color: var(--panel-2);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-top-width: 3px;
    border-color: var(--edge-dark);
}

.side-tab:hover {
    color: var(--ink);
}

.side-tab.is-on {
    color: var(--ink);
    background-color: var(--panel);
}

.side-tab.side-1.is-on {
    border-color: var(--side1);
}

.side-tab.side-2.is-on {
    border-color: var(--side2);
}

.cards-row {
    flex-direction: row;
    padding: 10px 10px 8px 10px;
}

.card {
    width: 92px;
    height: 128px;
    margin: 0 4px;
    padding: 8px 5px 5px 5px;
    background-color: #2b241a;
    border-width: 2px;
    border-color: #4b3b22;
    border-radius: 4px;
    transition-duration: 0.12s;
}

.card:hover {
    border-color: var(--gold-deep);
    translate: 0 -2px;
}

.card.is-selected {
    background-color: #3b301f;
    border-color: var(--gold-bright);
    translate: 0 -6px;
}

.card.is-out {
    opacity: 0.45;
}

.card-stripe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4px;
}

.card-stripe.side-1 {
    background-color: var(--side1);
}

.card-stripe.side-2 {
    background-color: var(--side2);
}

.card-icon {
    width: 40px;
    height: 40px;
    align-self: center;
    color: var(--ink);
}

.card-name {
    height: 26px;
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.card-men {
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.bar {
    height: 5px;
    margin-top: 3px;
    background-color: #15110b;
    border-radius: 2px;
}

.bar-fill {
    height: 100%;
    background-color: var(--hp);
    border-radius: 2px;
}

.bar-fill.is-low {
    background-color: var(--hp-low);
}

.bar-fill.morale {
    background-color: var(--morale);
}

.card-order {
    position: absolute;
    top: 6px;
    left: 5px;
    width: 18px;
    height: 18px;
    color: var(--ink-dim);
}

.card-order.is-new {
    color: var(--gold-bright);
}

.card-state {
    position: absolute;
    top: 6px;
    right: 5px;
    width: 18px;
    height: 18px;
    color: #e0806a;
}

.card-flag {
    position: absolute;
    left: 0;
    right: 0;
    top: 52px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #f2e6cc;
    background-color: rgba(150, 45, 32, 0.9);
}

/* ── подсказка над отрядом, всплывающая строка, конец битвы ── */
.tip {
    position: absolute;
    padding: 6px 10px;
}

.tip-name {
    -unity-font-style: bold;
}

.tip-line {
    font-size: 11px;
    color: var(--ink-dim);
}

.toast {
    position: absolute;
    top: 118px;
    left: 0;
    right: 0;
    align-items: center;
}

.toast-text {
    padding: 6px 16px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--gold-bright);
}

.over {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.over-box {
    align-items: center;
    padding: 24px 48px;
}

.over-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    margin-bottom: 6px;
}

.over-sub {
    color: var(--ink-dim);
    margin-bottom: 16px;
}

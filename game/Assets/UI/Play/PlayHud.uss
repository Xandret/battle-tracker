:root {
    --ink: #ece4d0;
    --ink-dim: #b3a78f;
    --ink-faint: #7d735f;
    --gold: #d9ad55;
    --gold-bright: #f3d283;
    --gold-deep: #8a6526;
    --panel: rgba(22, 18, 13, 0.93);
    --panel-2: rgba(40, 33, 24, 0.96);
    --edge: #6e532a;
    --edge-dark: #33271a;
    --side1: #b5372b;
    --side2: #2f63a8;
    --hp: #79b356;
    --hp-low: #c44b31;
    --morale: #d8b545;
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--ink);
    font-size: 13px;
}

.hidden {
    display: none;
}

.panel {
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--edge);
    border-radius: 6px;
}

/* ── верх: ход, фаза, «Ход!», скорость, силы сторон ── */
.top-bar {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    align-items: center;
}

.top-box {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px 6px 16px;
}

.turn-block {
    align-items: center;
    margin-right: 16px;
}

.turn-caption {
    font-size: 10px;
    color: var(--ink-dim);
    letter-spacing: 2px;
}

.turn-number {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--gold-bright);
}

.phase-block {
    width: 260px;
    margin-right: 14px;
}

.phase-text {
    font-size: 14px;
    -unity-font-style: bold;
}

.phase-sub {
    font-size: 11px;
    color: var(--ink-dim);
    white-space: normal;   /* длинная подсказка — в две строки, а не под кнопку «Ход!» */
    max-height: 30px;
    overflow: hidden;
}

.progress {
    height: 5px;
    margin-top: 5px;
    background-color: #15110b;
    border-radius: 2px;
}

.progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--gold);
    border-radius: 2px;
}

.go-button {
    width: 120px;
    height: 46px;
    margin: 0;
    padding: 0;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: #2a1d0a;
    background-color: var(--gold);
    border-width: 2px;
    border-color: var(--gold-bright);
    border-radius: 5px;
    transition-duration: 0.12s;
}

.go-button:hover {
    background-color: var(--gold-bright);
}

.go-button:active {
    background-color: var(--gold-deep);
}

.speed-group {
    flex-direction: row;
}

.speed-btn {
    width: 40px;
    height: 34px;
    margin: 0 2px;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--ink-dim);
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 4px;
}

.speed-btn:hover {
    border-color: var(--gold-deep);
    color: var(--ink);
}

.speed-btn.is-on {
    color: #2a1d0a;
    background-color: var(--gold);
    border-color: var(--gold-bright);
}

.power {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding: 3px 10px;
}

.power-name {
    font-size: 12px;
    -unity-font-style: bold;
    width: 110px;
}

.power-name.right {
    -unity-text-align: middle-right;
}

.power-bar {
    flex-direction: row;
    width: 300px;
    height: 10px;
    margin: 0 8px;
    border-width: 1px;
    border-color: var(--edge-dark);
}

.power-seg {
    height: 100%;
}

.power-seg.side-1 {
    background-color: var(--side1);
}

.power-seg.side-2 {
    background-color: var(--side2);
}

/* ── справа: журнал ── */
.log-panel {
    position: absolute;
    right: 10px;
    top: 104px;
    width: 340px;
    max-height: 60%;
    padding: 8px 10px;
    overflow: hidden;
}

.log-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    margin-bottom: 4px;
}

.log-line {
    font-size: 11px;
    color: var(--ink-dim);
    white-space: normal;
    margin-bottom: 3px;
}

.log-panel.is-collapsed > .log-line {
    display: none;
}

/* ── слева внизу: выбранный отряд ── */
.detail {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 300px;
    padding: 10px 12px;
}

.detail-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.detail-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    color: var(--gold-bright);
}

.detail-name {
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
}

.detail-type {
    font-size: 11px;
    color: var(--ink-dim);
}

.detail-row {
    flex-direction: row;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-color: var(--edge-dark);
    padding: 2px 0;
}

.detail-key {
    color: var(--ink-dim);
}

.detail-val {
    -unity-font-style: bold;
}

.detail-order {
    margin-top: 8px;
    color: var(--gold-bright);
    white-space: normal;
}

.detail-plan {
    color: var(--ink-dim);
    font-size: 12px;
    white-space: normal;
}

.detail-plan.is-bad {
    color: #e0806a;
}

.adj-box {
    margin-top: 4px;
    padding: 4px 6px;
    border-left-width: 2px;
    border-color: #c9a227;
    background-color: rgba(201, 162, 39, 0.08);
}

.gm-body {
    max-height: 250px;
}

.gm-body .unity-scroller--vertical {
    width: 8px;
}

.gm-row.gm-wrap {
    flex-wrap: wrap;
}

.sum-box > * {
    flex-shrink: 0;
}

.adj-scroll {
    max-height: 140px;
}

.adj-scroll .sum-event {
    margin-top: 2px;
    padding: 1px 4px;
}

.adj-scroll .sum-text {
    font-size: 11px;
}

.adj-head {
    font-size: 11px;
    -unity-font-style: bold;
    color: #d8b85a;
    margin-top: 4px;
}

.adj-line {
    font-size: 11px;
    color: var(--ink-dim);
    white-space: normal;
}

.adj-line.is-important {
    color: #e8b070;
}

.cards-row.is-compact .card-ai {
    top: 2px;
    right: 2px;
}

.log-line.is-ai {
    color: #9fb8d8;
}

.card-ai {
    position: absolute;
    right: 4px;
    top: 54px;
    font-size: 9px;
    -unity-font-style: bold;
    color: #9fb8d8;
    background-color: rgba(20, 30, 45, 0.85);
    padding: 0 2px;
    border-radius: 2px;
}

.detail-plan.is-good {
    color: #a6d48a;
}

/* ── низ: приказы, стороны, карточки ── */
.bottom-dock {
    position: absolute;
    left: 320px;
    right: 360px;
    bottom: 8px;
    align-items: center;
}

.orders-bar {
    flex-direction: row;
    padding: 3px;
    margin-bottom: 4px;
}

.order-btn {
    width: 58px;
    height: 46px;
    margin: 0 2px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 4px;
    transition-duration: 0.1s;
}

.order-btn:hover {
    background-color: #3d3223;
    border-color: var(--gold-deep);
}

.order-btn.is-on {
    background-color: #4a3a22;
    border-color: var(--gold);
}

/* ряд строев над панелью приказов (Г101, Г106) */
.formation-pop {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    margin-bottom: 4px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--gold-deep);
    border-radius: 5px;
}

.formation-col {
    align-items: center;
}

.formation-row {
    flex-direction: row;
}

.formation-group {
    font-size: 9px;
    color: var(--gold);
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.formation-btn {
    width: 66px;
}

.formation-sep {
    width: 1px;
    height: 52px;
    margin: 0 6px;
    background-color: var(--edge-dark);
}

.order-btn.is-soon .order-label {
    color: var(--ink-faint);
}

.order-btn.is-soon .order-icon {
    opacity: 0.5;
}

.order-btn.is-off {
    opacity: 0.35;
}

.order-icon {
    width: 22px;
    height: 22px;
    color: var(--ink);
}

.order-label {
    font-size: 10px;
    color: var(--ink-dim);
    margin-top: 2px;
}

.order-key {
    position: absolute;
    top: 2px;
    right: 4px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--gold);
}

/* поединки (Г108): вызовы и идущий поединок — под верхней панелью */
.duel-box {
    position: absolute;
    top: 150px;
    left: 0;
    right: 0;
    align-items: center;
}

.duel-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    margin-bottom: 4px;
}

.duel-row Label {
    color: var(--gold-bright);
    font-size: 13px;
    -unity-font-style: bold;
    margin-right: 10px;
}

/* всплывающая подсказка (Г116а) */
.hint-box {
    position: absolute;
    max-width: 340px;
    padding: 6px 10px;
    background-color: rgba(22, 18, 13, 0.96);
    border-width: 1px;
    border-color: var(--gold-deep);
    border-radius: 4px;
    font-size: 12px;
    color: var(--ink);
    white-space: normal;
}

/* инструменты ГМа (Г112) — раздел панели отряда */
.gm-box {
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-color: var(--edge-dark);
}

.gm-head {
    color: var(--gold);
    -unity-font-style: bold;
    font-size: 12px;
}

.gm-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.gm-key {
    width: 72px;
    font-size: 12px;
    color: var(--ink-dim);
}

.gm-val {
    min-width: 56px;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: var(--ink);
}

.gm-btn {
    min-width: 30px;
    height: 20px;
    margin: 0 1px;
    padding: 0 4px;
    font-size: 11px;
}

.gm-mod {
    margin-top: 4px;
    margin-left: 0;
    margin-right: 0;
    font-size: 12px;
}

.gm-mod > .unity-base-field__label {
    min-width: 86px;
    width: 86px;
    font-size: 12px;
}

.gm-mod > .unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
}

.gm-log {
    margin-top: 6px;
    font-size: 10px;
    color: var(--ink-faint);
    white-space: normal;
}

.view-tab {
    margin-left: 10px;
    color: var(--gold);
}

.side-tabs {
    flex-direction: row;
    align-self: center;
}

.side-tab {
    padding: 4px 16px;
    margin: 0 2px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--ink-faint);
    background-color: var(--panel-2);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-top-width: 3px;
    border-color: var(--edge-dark);
}

.side-tab:hover {
    color: var(--ink);
}

.side-tab.is-on {
    color: var(--ink);
    background-color: var(--panel);
}

.side-tab.side-1.is-on {
    border-color: var(--side1);
}

.side-tab.side-2.is-on {
    border-color: var(--side2);
}

.cards-row {
    flex-direction: row;
    padding: 8px 8px 6px 8px;
}

.card {
    width: 84px;
    height: 104px;
    margin: 0 3px;
    padding: 6px 4px 4px 4px;
    background-color: #2b241a;
    border-width: 2px;
    border-color: #4b3b22;
    border-radius: 4px;
    transition-duration: 0.12s;
}

.card:hover {
    border-color: var(--gold-deep);
    translate: 0 -2px;
}

.card.is-selected {
    background-color: #3b301f;
    border-color: var(--gold-bright);
    translate: 0 -6px;
}

.card.is-out {
    opacity: 0.45;
}

.card-stripe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4px;
}

.card-stripe.side-1 {
    background-color: var(--side1);
}

.card-stripe.side-2 {
    background-color: var(--side2);
}

.card-icon {
    width: 30px;
    height: 30px;
    align-self: center;
    color: var(--ink);
}

.card-name {
    height: 26px;
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.card-men {
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.bar {
    height: 5px;
    margin-top: 3px;
    background-color: #15110b;
    border-radius: 2px;
}

.bar-fill {
    height: 100%;
    background-color: var(--hp);
    border-radius: 2px;
}

.bar-fill.is-low {
    background-color: var(--hp-low);
}

.bar-fill.morale {
    background-color: var(--morale);
}

.card-order {
    position: absolute;
    top: 6px;
    left: 5px;
    width: 18px;
    height: 18px;
    color: var(--ink-dim);
}

.card-order.is-new {
    color: var(--gold-bright);
}

.card-state {
    position: absolute;
    top: 6px;
    right: 5px;
    width: 18px;
    height: 18px;
    color: #e0806a;
}

.card-flag {
    position: absolute;
    left: 0;
    right: 0;
    top: 22px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #f2e6cc;
    background-color: rgba(150, 45, 32, 0.9);
}

/* ── подсказка над отрядом, всплывающая строка, конец битвы ── */
.tip {
    position: absolute;
    padding: 6px 10px;
}

.tip-name {
    -unity-font-style: bold;
}

.tip-line {
    font-size: 11px;
    color: var(--ink-dim);
}

.toast {
    position: absolute;
    top: 118px;
    left: 0;
    right: 0;
    align-items: center;
}

.toast-text {
    padding: 6px 16px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--gold-bright);
}

.over {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.over-box {
    align-items: center;
    padding: 24px 48px;
}

.over-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    margin-bottom: 6px;
}

.over-sub {
    color: var(--ink-dim);
    margin-bottom: 16px;
}

.over-box > .go-button {
    width: auto;
    padding: 0 28px;
    font-size: 18px;
}

/* ── таблички над отрядами (как в Iron Kings): сторона, род войск, бойцы, имя; щелчок — выбрать, двойной — камера ── */
.tags {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.unit-tag {
    position: absolute;
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding-right: 6px;
    translate: -50% -100%;
    background-color: rgba(22, 18, 13, 0.86);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 3px;
    overflow: hidden;
}

.unit-tag:hover,
.unit-tag.is-hover {
    border-color: var(--gold-deep);
}

.unit-tag.is-selected {
    border-color: var(--gold-bright);
    background-color: rgba(59, 48, 31, 0.95);
}

.tag-cmd {
    font-size: 11px;
    -unity-font-style: bold;
    color: #f0c860;
    margin-left: 6px;
    padding-left: 4px;
    border-left-width: 3px;
    border-color: #f0c860;
    white-space: nowrap;
}

.unit-tag.has-cmd {
    border-color: #b8902e;
}

.unit-tag.is-flee {
    background-color: rgba(120, 34, 24, 0.9);
}

.tag-stripe {
    width: 4px;
    height: 100%;
}

.unit-tag.side-1 > .tag-stripe {
    background-color: var(--side1);
}

.unit-tag.side-2 > .tag-stripe {
    background-color: var(--side2);
}

.tag-icon {
    width: 15px;
    height: 15px;
    margin: 0 3px 0 4px;
    color: var(--ink);
}

.tag-men {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--ink);
}

.tag-name {
    font-size: 11px;
    margin-left: 6px;
    color: var(--ink-dim);
    max-width: 150px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.tag-state {
    width: 13px;
    height: 13px;
    margin-left: 4px;
    color: #e0806a;
}

/* ── меню битв: учебное поле и сохранения трекера ── */
.menu-button {
    position: absolute;
    left: 10px;
    top: 10px;
    height: 30px;
    padding: 0 14px;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--ink);
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--edge);
    border-radius: 5px;
}

.menu-button:hover {
    border-color: var(--gold);
    color: var(--gold-bright);
}

.menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.menu-box {
    width: 520px;
    padding: 20px 24px;
    align-items: stretch;
}

.menu-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.menu-item {
    padding: 10px 14px;
    margin-bottom: 8px;
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 5px;
    transition-duration: 0.1s;
}

.menu-item:hover {
    border-color: var(--gold);
    background-color: #3d3223;
}

.menu-item.is-current {
    border-color: var(--gold-deep);
}

.menu-item-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--ink);
}

.menu-item-note {
    font-size: 12px;
    color: var(--ink-dim);
    white-space: normal;
}

.menu-status {
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    margin: 4px 0 8px 0;
}

.menu-close {
    align-self: center;
    height: 32px;
    padding: 0 18px;
    color: var(--ink-dim);
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 4px;
}

.menu-close:hover {
    color: var(--ink);
    border-color: var(--gold-deep);
}

/* ── много отрядов: мини-карточки в несколько рядов, низ — шире ── */
.bottom-dock.is-wide {
    right: 10px;
}

.cards-row.is-compact {
    flex-wrap: wrap;
    justify-content: center;
    padding: 4px;
}

.cards-row.is-compact > .card {
    width: 46px;
    height: 58px;
    margin: 2px;
    padding: 4px 2px 2px 2px;
}

.cards-row.is-compact .card-icon {
    width: 22px;
    height: 22px;
}

.cards-row.is-compact .card-name,
.cards-row.is-compact .card-order,
.cards-row.is-compact .card-state {
    display: none;
}

.cards-row.is-compact .card-men {
    font-size: 11px;
}

.cards-row.is-compact .bar {
    height: 3px;
    margin-top: 2px;
}

.cards-row.is-compact .card-flag {
    top: 14px;
    font-size: 8px;
}

/* ── сводка хода справа ── */
.sum-box {
    margin-top: 2px;
}

.sum-side {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.sum-stripe {
    width: 4px;
    height: 14px;
    margin-right: 6px;
}

.sum-stripe.side-1 {
    background-color: var(--side1);
}

.sum-stripe.side-2 {
    background-color: var(--side2);
}

.sum-side-name {
    flex-grow: 1;
    font-size: 13px;
    -unity-font-style: bold;
}

.sum-loss {
    font-size: 13px;
    -unity-font-style: bold;
    color: #e0806a;
}

.sum-sub {
    font-size: 11px;
    color: var(--ink-dim);
    margin-left: 10px;
    white-space: normal;
}

.sum-hint {
    font-size: 12px;
    color: var(--ink-dim);
    white-space: normal;
}

.sum-event {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
    padding: 3px 4px;
    border-left-width: 3px;
    border-color: var(--edge-dark);
    border-radius: 2px;
}

.sum-event:hover {
    background-color: #3d3223;
}

.sum-event.side-1 {
    border-color: var(--side1);
}

.sum-event.side-2 {
    border-color: var(--side2);
}

.sum-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    color: var(--gold-bright);
}

.sum-text {
    flex-shrink: 1;
    font-size: 12px;
    white-space: normal;
}

.sum-toggle {
    margin-top: 8px;
    font-size: 11px;
    color: var(--gold);
}

.sum-toggle:hover {
    color: var(--gold-bright);
}

.sum-details {
    max-height: 260px;
    margin-top: 4px;
}

/* ── лента событий слева во время хода ── */
.feed {
    position: absolute;
    left: 10px;
    top: 50px;
    width: 330px;
}

.feed-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding: 5px 10px 5px 6px;
    background-color: var(--panel);
    border-left-width: 4px;
    border-color: var(--edge);
    border-radius: 3px;
}

.feed-row.side-1 {
    border-color: var(--side1);
}

.feed-row.side-2 {
    border-color: var(--side2);
}

.feed-icon {
    width: 18px;
    height: 18px;
    margin-right: 7px;
    color: var(--gold-bright);
}

.feed-text {
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}

.log-panel.is-collapsed > .sum-box,
.log-panel.is-collapsed > .sum-toggle,
.log-panel.is-collapsed > .sum-details {
    display: none;
}

.sum-loss.is-none {
    color: var(--ink-dim);
    -unity-font-style: normal;
}

/* ── редактор армий (Г93, шаг 1) ── */
.menu-armies {
    border-color: var(--gold-deep);
}

.army {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 10px 12px 28px 12px;
    background-color: rgb(16, 13, 9);
}

.army-top {
    flex-direction: row;
    align-items: center;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-color: var(--edge);
}

.army-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    margin-right: 14px;
}

.army-file {
    font-size: 13px;
    color: var(--ink-dim);
    margin-right: 14px;
}

.army-file.is-dirty {
    color: var(--gold-bright);
}

.army-btn {
    height: 28px;
    margin: 0 3px;
    padding: 0 12px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--ink);
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge);
    border-radius: 4px;
}

.army-btn:hover {
    border-color: var(--gold);
    color: var(--gold-bright);
}

.army-btn.is-gold {
    color: #2a1d0a;
    background-color: var(--gold);
    border-color: var(--gold-bright);
}

.army-btn.is-gold:hover {
    background-color: var(--gold-bright);
}

.army-btn.is-bad {
    color: #e0806a;
}

.army-btn.small {
    height: 22px;
    padding: 0 8px;
    font-size: 11px;
}

.army-saveas {
    width: 150px;
    margin: 0 3px;
}

.army-files {
    position: absolute;
    left: 150px;
    top: 48px;
    width: 420px;
    max-height: 420px;
    padding: 6px;
    background-color: var(--panel-2);
    border-width: 2px;
    border-color: var(--gold-deep);
    border-radius: 5px;
}

.army-file-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 8px;
    border-radius: 3px;
}

.army-file-row:hover {
    background-color: #3d3223;
}

.army-file-name {
    -unity-font-style: bold;
}

.army-file-where {
    font-size: 11px;
    color: var(--ink-dim);
}

.army-body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 8px;
}

.army-col {
    padding: 6px 8px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 5px;
}

.army-left {
    width: 300px;
    margin-right: 8px;
}

.army-mid {
    flex-grow: 1;
    margin-right: 8px;
}

.army-right {
    width: 380px;
}

.army-scroll {
    flex-grow: 1;
}

.army-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 4px 0 6px 0;
}

.army-head-btns {
    flex-direction: row;
}

.army-h {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--gold-bright);
}

.army-h2 {
    margin-top: 10px;
    margin-bottom: 2px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--gold);
}

.army-note {
    font-size: 11px;
    color: var(--ink-dim);
    white-space: normal;
    margin: 2px 0 4px 0;
}

.army-note.warn {
    color: #e0b070;
}

.army-list {
    margin-bottom: 8px;
}

.army-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin-bottom: 2px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 3px;
}

.army-row:hover {
    background-color: #2b241a;
}

.army-row.is-on {
    background-color: #3b301f;
    border-color: var(--gold-deep);
}

.army-swatch {
    width: 12px;
    height: 12px;
    margin-right: 7px;
    border-width: 1px;
    border-color: #15110b;
    border-radius: 2px;
}

.army-swatch.big {
    width: 18px;
    height: 18px;
    margin: 2px;
}

.army-swatch.is-on {
    border-color: var(--gold-bright);
    border-width: 2px;
}

.army-palette {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0;
}

.army-row-name {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
}

.army-row-sub {
    font-size: 11px;
    color: var(--ink-dim);
}

.army-faction {
    padding: 6px 0;
    margin-bottom: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--edge-dark);
}

.army-cards {
    flex-direction: row;
    flex-wrap: wrap;
}

.army-card-thumb {
    height: 46px;
    margin: -4px -4px 4px -4px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    background-color: #20190f;
}

.army-preview {
    margin-bottom: 8px;
    border-width: 1px;
    border-color: var(--edge);
    border-radius: 4px;
    overflow: hidden;
    background-color: #20190f;
}

.army-preview-img {
    height: 200px;
}

.army-preview-note {
    font-size: 11px;
    color: var(--ink-dim);
    padding: 4px 6px;
    white-space: normal;
}

.army-card {
    width: 132px;
    height: 170px;
    margin: 4px;
    padding: 5px 6px 6px 6px;
    background-color: #2b241a;
    border-width: 2px;
    border-top-width: 5px;
    border-color: #4b3b22;
    border-radius: 4px;
}

.army-card:hover {
    border-color: var(--gold-deep);
}

.army-card.is-on {
    background-color: #3b301f;
    border-color: var(--gold-bright);
}

.army-card-icon {
    width: 22px;
    height: 22px;
    margin-bottom: 2px;
    flex-shrink: 0;
    align-self: center;
    color: var(--ink);
}

.army-card-name {
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    height: 28px;
    margin: 0;
    flex-shrink: 0;
}

.army-card-men {
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--gold-bright);
    margin: 2px 0;
    flex-shrink: 0;
}

.army-card-sub {
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0;
    color: var(--ink-dim);
}

.army-card-flag {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(150, 45, 32, 0.9);
}

.army-form > * {
    margin-bottom: 3px;
}

.army-status {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 6px;
    font-size: 12px;
    color: var(--gold-bright);
}

.army-status.is-bad {
    color: #e0806a;
}

/* поля ввода — в тёмном стиле */
.army .unity-base-field {
    margin: 2px 0;
}

.army .unity-base-field__label {
    min-width: 150px;
    font-size: 12px;
    color: var(--ink-dim);
}

.army .unity-base-text-field__input,
.army .unity-base-popup-field__input {
    background-color: #15110b;
    border-color: var(--edge);
    color: var(--ink);
    font-size: 12px;
}

.army .unity-base-text-field__input:focus,
.army .unity-base-popup-field__input:focus {
    border-color: var(--gold);
}

.army .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--gold);
}


/* слева колонка узкая — подпись над полем */
.army-left .unity-base-field {
    flex-direction: column;
    align-items: stretch;
}

.army-left .unity-base-field__label {
    min-width: 0;
    margin-bottom: 1px;
}

/* полосы прокрутки — тёмные, тонкие */
.army .unity-scroller--vertical {
    width: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.army .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: #15110b;
    border-width: 0;
}

.army .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--edge);
    border-width: 0;
    border-radius: 3px;
}

.army .unity-scroller__low-button,
.army .unity-scroller__high-button {
    display: none;
}

/* ── состав битвы из сохранения трекера (Г98: первая битва малым составом) ── */
.lineup-box {
    width: 900px;
    max-height: 86%;
    padding: 18px 22px;
    align-items: stretch;
}

.lineup-sub {
    color: var(--ink-dim);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.lineup-cols {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 200px;
}

.lineup-col {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 6px;
}

.lineup-head {
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
    padding: 6px 10px;
    border-left-width: 4px;
    background-color: var(--panel-2);
    margin-bottom: 4px;
}

.lineup-head.is-side1 { border-left-color: var(--side1); }
.lineup-head.is-side2 { border-left-color: var(--side2); }

.lineup-bar {
    flex-direction: row;
    margin-bottom: 4px;
}

.lineup-mini {
    height: 22px;
    padding: 0 10px;
    margin-right: 6px;
    font-size: 12px;
    color: var(--ink-dim);
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 3px;
}

.lineup-mini:hover { color: var(--ink); border-color: var(--gold-deep); }

.lineup-list {
    flex-grow: 1;
    flex-shrink: 1;
    max-height: 420px;
    background-color: rgba(0, 0, 0, 0.18);
    border-radius: 4px;
}

.lineup-unit {
    margin: 2px 6px;
    font-size: 13px;
    color: var(--ink);
}

.lineup-foot {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.lineup-foot > .menu-close { margin: 0 6px; }

.lineup-start {
    width: auto;
    padding: 0 24px;
    margin-left: 12px;
    font-size: 17px;
}

.menu-open { border-color: var(--gold-deep); }
.menu-end { border-color: var(--hp-low); }

/* ── итог битвы: по сторонам и отрядам ── */
.over-table {
    width: 820px;
    max-height: 420px;
    margin-bottom: 14px;
}

.over-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 8px;
}

.over-side {
    margin-top: 10px;
    padding: 6px 10px;
    border-left-width: 4px;
    background-color: var(--panel-2);
    flex-wrap: wrap;
}

.over-side.is-side1 { border-left-color: var(--side1); }
.over-side.is-side2 { border-left-color: var(--side2); }

.over-side-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    margin-right: 12px;
}

.over-side-sum { color: var(--ink); font-size: 13px; }

.over-hdr > Label { color: var(--ink-faint); font-size: 11px; }

.oc-name { flex-grow: 1; flex-basis: 0; font-size: 13px; color: var(--ink); overflow: hidden; }
.oc-num { width: 70px; -unity-text-align: middle-right; font-size: 13px; color: var(--ink); }
.oc-state { width: 110px; padding-left: 12px; font-size: 12px; color: var(--ink-dim); }

/* ── главное меню (заставка и пауза) ── */
.hud.is-bare .top-bar, .hud.is-bare .bottom-dock, .hud.is-bare .log-panel, .hud.is-bare .tags, .hud.is-bare .feed,
.hud.is-bare .detail, .hud.is-bare .tip, .hud.is-bare .menu-button {
    display: none;
}

.main-menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 8, 6, 0.78);
}

.main-menu.is-splash {
    align-items: flex-start;
    padding-left: 6%;
    background-color: rgba(10, 8, 6, 0);
}

.main-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    -unity-background-scale-mode: stretch-to-fill;
}

.main-menu.is-splash > .main-vignette {
    display: flex;
}

.main-menu.is-splash > .main-box {
    background-color: rgba(26, 21, 15, 0.82);
    border-color: rgba(176, 138, 66, 0.7);
}

.main-menu.is-splash .main-title {
    font-size: 40px;
    letter-spacing: 1px;
}

.main-orn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 6px 0 4px 0;
}

.main-orn-line {
    width: 90px;
    height: 1px;
    background-color: var(--gold);
    opacity: 0.8;
}

.main-orn-dia {
    width: 8px;
    height: 8px;
    margin: 0 8px;
    rotate: 45deg;
    background-color: var(--gold-bright);
}

.main-menu.is-pause {
    background-color: rgba(10, 8, 6, 0.55);
}

.main-box {
    width: 420px;
    align-items: stretch;
    padding: 30px 36px 22px 36px;
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--edge);
    border-radius: 6px;
}

.main-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    white-space: normal;
}

.main-sub {
    font-size: 14px;
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    margin-bottom: 22px;
}

.main-button {
    height: 46px;
    margin: 5px 0;
    font-size: 19px;
    color: var(--ink);
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 5px;
    transition-duration: 0.1s;
}

.main-button:hover {
    border-color: var(--gold);
    background-color: #3d3223;
}

.main-button.is-gold {
    color: #1d160c;
    background-color: var(--gold);
    border-color: var(--gold-bright);
    -unity-font-style: bold;
}

.main-button.is-gold:hover { background-color: var(--gold-bright); }

.main-button.is-quiet { color: var(--ink-dim); margin-top: 14px; }

.main-hint {
    margin-top: 14px;
    font-size: 12px;
    color: var(--ink-faint);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ── настройки ── */
.settings-box {
    width: 560px;
    padding: 20px 26px;
    align-items: stretch;
}

.set-head {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--gold);
    margin: 12px 0 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--edge-dark);
}

.set-field {
    margin: 4px 0;
    color: var(--ink);
}

.set-field Label { color: var(--ink); min-width: 220px; }

.set-value { color: var(--gold-bright); min-width: 50px; -unity-text-align: middle-right; }

.set-note {
    font-size: 12px;
    color: var(--ink-faint);
    white-space: normal;
    margin: 2px 0 4px 0;
}

/* ── бой своими армиями ── */
.ab-row {
    flex-direction: row;
    align-items: center;
}

.ab-row > .ab-drop { flex-grow: 1; }

.ab-drop { margin: 3px 0; color: var(--ink); }

.ab-drop Label { color: var(--ink-dim); min-width: 70px; }

.ab-sum { color: var(--ink-dim); font-size: 12px; margin-left: 8px; -unity-text-align: middle-left; }

.ab-map {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
}

.ab-map > .ab-drop { width: 300px; }

.ab-seed { color: var(--ink-faint); font-size: 12px; margin: 0 10px; }

/* ── поля в тон окнам: выпадающие списки, галочки, ползунок (вместо светлых по умолчанию) ── */
.unity-base-popup-field__input {
    background-color: #2b241a;
    border-color: var(--edge-dark);
    border-radius: 3px;
    color: var(--ink);
}

.unity-base-popup-field__input:hover { border-color: var(--gold-deep); }
.unity-base-popup-field__text { color: var(--ink); }
.unity-base-popup-field__arrow { -unity-background-image-tint-color: var(--gold); }

.unity-toggle__checkmark {
    background-color: #2b241a;
    border-color: var(--edge);
    -unity-background-image-tint-color: var(--gold-bright);
}

.unity-toggle__label, .unity-toggle__text { color: var(--ink); }

.unity-base-slider__dragger { background-color: var(--gold); border-color: var(--gold-deep); }
.unity-base-slider__tracker { background-color: #2b241a; border-color: var(--edge-dark); }

/* ── редактор карт (Г100): панель слева, карта — в смотрелке ── */
.me-root { position: absolute; left: 0; top: 0; bottom: 0; right: 0; }
.me-panel { position: absolute; left: 10px; top: 10px; bottom: 10px; width: 340px; padding: 10px 8px 10px 12px; }
.me-title { font-size: 20px; -unity-font-style: bold; color: var(--gold-bright); margin-bottom: 6px; }
.me-row { flex-direction: row; align-items: center; flex-wrap: wrap; margin: 2px 0; }
.me-wrap { flex-wrap: wrap; }
.me-btn { margin: 2px 4px 2px 0; }
.me-tool { min-width: 98px; height: 26px; }
.me-tool.is-on, .me-btn.is-on { color: var(--gold-bright); border-color: var(--gold); background-color: rgba(217, 173, 85, 0.18); }
.me-field { margin: 3px 0; color: var(--ink); }
.me-field Label { color: var(--ink-dim); min-width: 120px; }
.me-num { width: 190px; color: var(--ink); }
.me-num Label { color: var(--ink-dim); min-width: 90px; }
.me-num-short { width: 110px; }
.me-num-short Label { min-width: 14px; }
.me-opts { margin: 6px 0; padding: 6px; background-color: rgba(0, 0, 0, 0.18); border-radius: 4px; }
.me-note { color: var(--ink-faint); font-size: 12px; white-space: normal; margin: 4px 0; }
.me-palette { flex-direction: row; flex-wrap: wrap; }
.me-swatch-btn { flex-direction: row; align-items: center; width: 138px; height: 24px; margin: 2px; padding: 0 6px; background-color: var(--panel-2); border-color: var(--edge-dark); border-width: 1px; border-radius: 3px; }
.me-swatch-btn:hover { border-color: var(--gold-deep); }
.me-swatch-btn.is-on { border-color: var(--gold); background-color: rgba(217, 173, 85, 0.18); }
.me-swatch { width: 16px; height: 16px; border-radius: 2px; border-width: 1px; border-color: rgba(0, 0, 0, 0.5); margin-right: 6px; }
.me-swatch-name { color: var(--ink); font-size: 12px; }
.me-sel { color: var(--gold-bright); -unity-font-style: bold; margin: 2px 0 4px 0; }
.me-danger { color: #e08a72; }
.me-files { padding: 4px; margin: 2px 0 6px 0; background-color: rgba(0, 0, 0, 0.25); border-radius: 4px; }
.me-file { -unity-text-align: middle-left; }
.me-gen { margin: 2px 0; }
.me-make, .me-test { height: 32px; margin: 6px 4px 6px 0; font-size: 15px; }
.me-toast { color: var(--gold-bright); white-space: normal; margin-top: 6px; }
.me-status { color: var(--ink-dim); font-size: 12px; white-space: normal; margin-top: 6px; }

.me-panel .unity-base-field__label { min-width: 130px; font-size: 12px; color: var(--ink-dim); }
.me-panel .unity-base-text-field__input,
.me-panel .unity-base-popup-field__input { background-color: #15110b; border-color: var(--edge); color: var(--ink); font-size: 12px; }
.me-panel .unity-base-text-field__input:focus,
.me-panel .unity-base-popup-field__input:focus { border-color: var(--gold); }
.me-panel .unity-base-popup-field__arrow { -unity-background-image-tint-color: var(--gold); }
.me-panel .unity-toggle__checkmark { background-color: #15110b; border-color: var(--edge); }
.me-num .unity-base-field__label { min-width: 70px; }
.me-num-short .unity-base-field__label { min-width: 12px; }

/* поля раздела ГМа — тёмные, как в редакторе карт */
.gm-box .unity-base-text-field__input, .gm-box .unity-base-popup-field__input { background-color: #15110b; border-color: var(--edge); color: var(--ink); font-size: 12px; }
.gm-box .unity-base-text-field__input:focus, .gm-box .unity-base-popup-field__input:focus { border-color: var(--gold); }
.gm-box .unity-base-popup-field__arrow { -unity-background-image-tint-color: var(--gold); }

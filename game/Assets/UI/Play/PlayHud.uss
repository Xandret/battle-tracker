:root {
    --ink: #ece4d0;
    --ink-dim: #b3a78f;
    --ink-faint: #7d735f;
    --gold: #d9ad55;
    --gold-bright: #f3d283;
    --gold-deep: #8a6526;
    --panel: rgba(22, 18, 13, 0.93);
    --panel-2: rgba(40, 33, 24, 0.96);
    --edge: #6e532a;
    --edge-dark: #33271a;
    --side1: #b5372b;
    --side2: #2f63a8;
    --hp: #79b356;
    --hp-low: #c44b31;
    --morale: #d8b545;
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--ink);
    font-size: 13px;
}

.hidden {
    display: none;
}

.panel {
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--edge);
    border-radius: 6px;
}

/* ── верх: ход, фаза, «Ход!», скорость, силы сторон ── */
.top-bar {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    align-items: center;
}

.top-box {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px 6px 16px;
}

.turn-block {
    align-items: center;
    margin-right: 16px;
}

.turn-caption {
    font-size: 10px;
    color: var(--ink-dim);
    letter-spacing: 2px;
}

.turn-number {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--gold-bright);
}

.phase-block {
    width: 230px;
    margin-right: 14px;
}

.phase-text {
    font-size: 14px;
    -unity-font-style: bold;
}

.phase-sub {
    font-size: 11px;
    color: var(--ink-dim);
}

.progress {
    height: 5px;
    margin-top: 5px;
    background-color: #15110b;
    border-radius: 2px;
}

.progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--gold);
    border-radius: 2px;
}

.go-button {
    width: 120px;
    height: 46px;
    margin: 0;
    padding: 0;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: #2a1d0a;
    background-color: var(--gold);
    border-width: 2px;
    border-color: var(--gold-bright);
    border-radius: 5px;
    transition-duration: 0.12s;
}

.go-button:hover {
    background-color: var(--gold-bright);
}

.go-button:active {
    background-color: var(--gold-deep);
}

.speed-group {
    flex-direction: row;
}

.speed-btn {
    width: 40px;
    height: 34px;
    margin: 0 2px;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--ink-dim);
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 4px;
}

.speed-btn:hover {
    border-color: var(--gold-deep);
    color: var(--ink);
}

.speed-btn.is-on {
    color: #2a1d0a;
    background-color: var(--gold);
    border-color: var(--gold-bright);
}

.power {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding: 3px 10px;
}

.power-name {
    font-size: 12px;
    -unity-font-style: bold;
    width: 110px;
}

.power-name.right {
    -unity-text-align: middle-right;
}

.power-bar {
    flex-direction: row;
    width: 300px;
    height: 10px;
    margin: 0 8px;
    border-width: 1px;
    border-color: var(--edge-dark);
}

.power-seg {
    height: 100%;
}

.power-seg.side-1 {
    background-color: var(--side1);
}

.power-seg.side-2 {
    background-color: var(--side2);
}

/* ── справа: журнал ── */
.log-panel {
    position: absolute;
    right: 10px;
    top: 104px;
    width: 340px;
    max-height: 46%;
    padding: 8px 10px;
    overflow: hidden;
}

.log-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    margin-bottom: 4px;
}

.log-line {
    font-size: 11px;
    color: var(--ink-dim);
    white-space: normal;
    margin-bottom: 3px;
}

.log-panel.is-collapsed > .log-line {
    display: none;
}

/* ── слева внизу: выбранный отряд ── */
.detail {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 300px;
    padding: 10px 12px;
}

.detail-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.detail-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    color: var(--gold-bright);
}

.detail-name {
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
}

.detail-type {
    font-size: 11px;
    color: var(--ink-dim);
}

.detail-row {
    flex-direction: row;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-color: var(--edge-dark);
    padding: 2px 0;
}

.detail-key {
    color: var(--ink-dim);
}

.detail-val {
    -unity-font-style: bold;
}

.detail-order {
    margin-top: 8px;
    color: var(--gold-bright);
    white-space: normal;
}

.detail-plan {
    color: var(--ink-dim);
    font-size: 12px;
    white-space: normal;
}

.detail-plan.is-bad {
    color: #e0806a;
}

.detail-plan.is-good {
    color: #a6d48a;
}

/* ── низ: приказы, стороны, карточки ── */
.bottom-dock {
    position: absolute;
    left: 320px;
    right: 360px;
    bottom: 8px;
    align-items: center;
}

.orders-bar {
    flex-direction: row;
    padding: 3px;
    margin-bottom: 4px;
}

.order-btn {
    width: 58px;
    height: 46px;
    margin: 0 2px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 4px;
    transition-duration: 0.1s;
}

.order-btn:hover {
    background-color: #3d3223;
    border-color: var(--gold-deep);
}

.order-btn.is-on {
    background-color: #4a3a22;
    border-color: var(--gold);
}

.order-btn.is-off {
    opacity: 0.35;
}

.order-icon {
    width: 22px;
    height: 22px;
    color: var(--ink);
}

.order-label {
    font-size: 10px;
    color: var(--ink-dim);
    margin-top: 2px;
}

.order-key {
    position: absolute;
    top: 2px;
    right: 4px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--gold);
}

.side-tabs {
    flex-direction: row;
    align-self: center;
}

.side-tab {
    padding: 4px 16px;
    margin: 0 2px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--ink-faint);
    background-color: var(--panel-2);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-top-width: 3px;
    border-color: var(--edge-dark);
}

.side-tab:hover {
    color: var(--ink);
}

.side-tab.is-on {
    color: var(--ink);
    background-color: var(--panel);
}

.side-tab.side-1.is-on {
    border-color: var(--side1);
}

.side-tab.side-2.is-on {
    border-color: var(--side2);
}

.cards-row {
    flex-direction: row;
    padding: 8px 8px 6px 8px;
}

.card {
    width: 84px;
    height: 104px;
    margin: 0 3px;
    padding: 6px 4px 4px 4px;
    background-color: #2b241a;
    border-width: 2px;
    border-color: #4b3b22;
    border-radius: 4px;
    transition-duration: 0.12s;
}

.card:hover {
    border-color: var(--gold-deep);
    translate: 0 -2px;
}

.card.is-selected {
    background-color: #3b301f;
    border-color: var(--gold-bright);
    translate: 0 -6px;
}

.card.is-out {
    opacity: 0.45;
}

.card-stripe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4px;
}

.card-stripe.side-1 {
    background-color: var(--side1);
}

.card-stripe.side-2 {
    background-color: var(--side2);
}

.card-icon {
    width: 30px;
    height: 30px;
    align-self: center;
    color: var(--ink);
}

.card-name {
    height: 26px;
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.card-men {
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.bar {
    height: 5px;
    margin-top: 3px;
    background-color: #15110b;
    border-radius: 2px;
}

.bar-fill {
    height: 100%;
    background-color: var(--hp);
    border-radius: 2px;
}

.bar-fill.is-low {
    background-color: var(--hp-low);
}

.bar-fill.morale {
    background-color: var(--morale);
}

.card-order {
    position: absolute;
    top: 6px;
    left: 5px;
    width: 18px;
    height: 18px;
    color: var(--ink-dim);
}

.card-order.is-new {
    color: var(--gold-bright);
}

.card-state {
    position: absolute;
    top: 6px;
    right: 5px;
    width: 18px;
    height: 18px;
    color: #e0806a;
}

.card-flag {
    position: absolute;
    left: 0;
    right: 0;
    top: 22px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #f2e6cc;
    background-color: rgba(150, 45, 32, 0.9);
}

/* ── подсказка над отрядом, всплывающая строка, конец битвы ── */
.tip {
    position: absolute;
    padding: 6px 10px;
}

.tip-name {
    -unity-font-style: bold;
}

.tip-line {
    font-size: 11px;
    color: var(--ink-dim);
}

.toast {
    position: absolute;
    top: 118px;
    left: 0;
    right: 0;
    align-items: center;
}

.toast-text {
    padding: 6px 16px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--gold-bright);
}

.over {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.over-box {
    align-items: center;
    padding: 24px 48px;
}

.over-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    margin-bottom: 6px;
}

.over-sub {
    color: var(--ink-dim);
    margin-bottom: 16px;
}

.over-box > .go-button {
    width: auto;
    padding: 0 28px;
    font-size: 18px;
}

/* ── таблички над отрядами (как в Iron Kings): сторона, род войск, бойцы, имя; щелчок — выбрать, двойной — камера ── */
.tags {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.unit-tag {
    position: absolute;
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding-right: 6px;
    translate: -50% -100%;
    background-color: rgba(22, 18, 13, 0.86);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 3px;
    overflow: hidden;
}

.unit-tag:hover,
.unit-tag.is-hover {
    border-color: var(--gold-deep);
}

.unit-tag.is-selected {
    border-color: var(--gold-bright);
    background-color: rgba(59, 48, 31, 0.95);
}

.unit-tag.is-flee {
    background-color: rgba(120, 34, 24, 0.9);
}

.tag-stripe {
    width: 4px;
    height: 100%;
}

.unit-tag.side-1 > .tag-stripe {
    background-color: var(--side1);
}

.unit-tag.side-2 > .tag-stripe {
    background-color: var(--side2);
}

.tag-icon {
    width: 15px;
    height: 15px;
    margin: 0 3px 0 4px;
    color: var(--ink);
}

.tag-men {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--ink);
}

.tag-name {
    font-size: 11px;
    margin-left: 6px;
    color: var(--ink-dim);
    max-width: 150px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.tag-state {
    width: 13px;
    height: 13px;
    margin-left: 4px;
    color: #e0806a;
}

/* ── меню битв: учебное поле и сохранения трекера ── */
.menu-button {
    position: absolute;
    left: 10px;
    top: 10px;
    height: 30px;
    padding: 0 14px;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--ink);
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--edge);
    border-radius: 5px;
}

.menu-button:hover {
    border-color: var(--gold);
    color: var(--gold-bright);
}

.menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.menu-box {
    width: 520px;
    padding: 20px 24px;
    align-items: stretch;
}

.menu-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.menu-item {
    padding: 10px 14px;
    margin-bottom: 8px;
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 5px;
    transition-duration: 0.1s;
}

.menu-item:hover {
    border-color: var(--gold);
    background-color: #3d3223;
}

.menu-item.is-current {
    border-color: var(--gold-deep);
}

.menu-item-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--ink);
}

.menu-item-note {
    font-size: 12px;
    color: var(--ink-dim);
    white-space: normal;
}

.menu-status {
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    margin: 4px 0 8px 0;
}

.menu-close {
    align-self: center;
    height: 32px;
    padding: 0 18px;
    color: var(--ink-dim);
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 4px;
}

.menu-close:hover {
    color: var(--ink);
    border-color: var(--gold-deep);
}

/* ── много отрядов: мини-карточки в несколько рядов, низ — шире ── */
.bottom-dock.is-wide {
    right: 10px;
}

.cards-row.is-compact {
    flex-wrap: wrap;
    justify-content: center;
    padding: 4px;
}

.cards-row.is-compact > .card {
    width: 46px;
    height: 58px;
    margin: 2px;
    padding: 4px 2px 2px 2px;
}

.cards-row.is-compact .card-icon {
    width: 22px;
    height: 22px;
}

.cards-row.is-compact .card-name,
.cards-row.is-compact .card-order,
.cards-row.is-compact .card-state {
    display: none;
}

.cards-row.is-compact .card-men {
    font-size: 11px;
}

.cards-row.is-compact .bar {
    height: 3px;
    margin-top: 2px;
}

.cards-row.is-compact .card-flag {
    top: 14px;
    font-size: 8px;
}

/* ── сводка хода справа ── */
.sum-box {
    margin-top: 2px;
}

.sum-side {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.sum-stripe {
    width: 4px;
    height: 14px;
    margin-right: 6px;
}

.sum-stripe.side-1 {
    background-color: var(--side1);
}

.sum-stripe.side-2 {
    background-color: var(--side2);
}

.sum-side-name {
    flex-grow: 1;
    font-size: 13px;
    -unity-font-style: bold;
}

.sum-loss {
    font-size: 13px;
    -unity-font-style: bold;
    color: #e0806a;
}

.sum-sub {
    font-size: 11px;
    color: var(--ink-dim);
    margin-left: 10px;
    white-space: normal;
}

.sum-hint {
    font-size: 12px;
    color: var(--ink-dim);
    white-space: normal;
}

.sum-event {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
    padding: 3px 4px;
    border-left-width: 3px;
    border-color: var(--edge-dark);
    border-radius: 2px;
}

.sum-event:hover {
    background-color: #3d3223;
}

.sum-event.side-1 {
    border-color: var(--side1);
}

.sum-event.side-2 {
    border-color: var(--side2);
}

.sum-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    color: var(--gold-bright);
}

.sum-text {
    flex-shrink: 1;
    font-size: 12px;
    white-space: normal;
}

.sum-toggle {
    margin-top: 8px;
    font-size: 11px;
    color: var(--gold);
}

.sum-toggle:hover {
    color: var(--gold-bright);
}

.sum-details {
    max-height: 260px;
    margin-top: 4px;
}

/* ── лента событий слева во время хода ── */
.feed {
    position: absolute;
    left: 10px;
    top: 50px;
    width: 330px;
}

.feed-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding: 5px 10px 5px 6px;
    background-color: var(--panel);
    border-left-width: 4px;
    border-color: var(--edge);
    border-radius: 3px;
}

.feed-row.side-1 {
    border-color: var(--side1);
}

.feed-row.side-2 {
    border-color: var(--side2);
}

.feed-icon {
    width: 18px;
    height: 18px;
    margin-right: 7px;
    color: var(--gold-bright);
}

.feed-text {
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}

.log-panel.is-collapsed > .sum-box,
.log-panel.is-collapsed > .sum-toggle,
.log-panel.is-collapsed > .sum-details {
    display: none;
}

.sum-loss.is-none {
    color: var(--ink-dim);
    -unity-font-style: normal;
}

/* ── редактор армий (Г93, шаг 1) ── */
.menu-armies {
    border-color: var(--gold-deep);
}

.army {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 10px 12px 28px 12px;
    background-color: rgb(16, 13, 9);
}

.army-top {
    flex-direction: row;
    align-items: center;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-color: var(--edge);
}

.army-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    margin-right: 14px;
}

.army-file {
    font-size: 13px;
    color: var(--ink-dim);
    margin-right: 14px;
}

.army-file.is-dirty {
    color: var(--gold-bright);
}

.army-btn {
    height: 28px;
    margin: 0 3px;
    padding: 0 12px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--ink);
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge);
    border-radius: 4px;
}

.army-btn:hover {
    border-color: var(--gold);
    color: var(--gold-bright);
}

.army-btn.is-gold {
    color: #2a1d0a;
    background-color: var(--gold);
    border-color: var(--gold-bright);
}

.army-btn.is-gold:hover {
    background-color: var(--gold-bright);
}

.army-btn.is-bad {
    color: #e0806a;
}

.army-btn.small {
    height: 22px;
    padding: 0 8px;
    font-size: 11px;
}

.army-saveas {
    width: 150px;
    margin: 0 3px;
}

.army-files {
    position: absolute;
    left: 150px;
    top: 48px;
    width: 420px;
    max-height: 420px;
    padding: 6px;
    background-color: var(--panel-2);
    border-width: 2px;
    border-color: var(--gold-deep);
    border-radius: 5px;
}

.army-file-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 8px;
    border-radius: 3px;
}

.army-file-row:hover {
    background-color: #3d3223;
}

.army-file-name {
    -unity-font-style: bold;
}

.army-file-where {
    font-size: 11px;
    color: var(--ink-dim);
}

.army-body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 8px;
}

.army-col {
    padding: 6px 8px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--edge-dark);
    border-radius: 5px;
}

.army-left {
    width: 300px;
    margin-right: 8px;
}

.army-mid {
    flex-grow: 1;
    margin-right: 8px;
}

.army-right {
    width: 380px;
}

.army-scroll {
    flex-grow: 1;
}

.army-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 4px 0 6px 0;
}

.army-head-btns {
    flex-direction: row;
}

.army-h {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--gold-bright);
}

.army-h2 {
    margin-top: 10px;
    margin-bottom: 2px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--gold);
}

.army-note {
    font-size: 11px;
    color: var(--ink-dim);
    white-space: normal;
    margin: 2px 0 4px 0;
}

.army-note.warn {
    color: #e0b070;
}

.army-list {
    margin-bottom: 8px;
}

.army-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin-bottom: 2px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 3px;
}

.army-row:hover {
    background-color: #2b241a;
}

.army-row.is-on {
    background-color: #3b301f;
    border-color: var(--gold-deep);
}

.army-swatch {
    width: 12px;
    height: 12px;
    margin-right: 7px;
    border-width: 1px;
    border-color: #15110b;
    border-radius: 2px;
}

.army-swatch.big {
    width: 18px;
    height: 18px;
    margin: 2px;
}

.army-swatch.is-on {
    border-color: var(--gold-bright);
    border-width: 2px;
}

.army-palette {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0;
}

.army-row-name {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
}

.army-row-sub {
    font-size: 11px;
    color: var(--ink-dim);
}

.army-faction {
    padding: 6px 0;
    margin-bottom: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--edge-dark);
}

.army-cards {
    flex-direction: row;
    flex-wrap: wrap;
}

.army-card {
    width: 132px;
    height: 112px;
    margin: 4px;
    padding: 8px 6px 6px 6px;
    background-color: #2b241a;
    border-width: 2px;
    border-color: #4b3b22;
    border-radius: 4px;
}

.army-card:hover {
    border-color: var(--gold-deep);
}

.army-card.is-on {
    background-color: #3b301f;
    border-color: var(--gold-bright);
}

.army-card-stripe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4px;
}

.army-card-icon {
    width: 28px;
    height: 28px;
    align-self: center;
    color: var(--ink);
}

.army-card-name {
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    height: 28px;
}

.army-card-men {
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--gold-bright);
}

.army-card-sub {
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--ink-dim);
}

.army-card-flag {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(150, 45, 32, 0.9);
}

.army-form > * {
    margin-bottom: 3px;
}

.army-status {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 6px;
    font-size: 12px;
    color: var(--gold-bright);
}

.army-status.is-bad {
    color: #e0806a;
}

/* поля ввода — в тёмном стиле */
.army .unity-base-field {
    margin: 2px 0;
}

.army .unity-base-field__label {
    min-width: 150px;
    font-size: 12px;
    color: var(--ink-dim);
}

.army .unity-base-text-field__input,
.army .unity-base-popup-field__input {
    background-color: #15110b;
    border-color: var(--edge);
    color: var(--ink);
    font-size: 12px;
}

.army .unity-base-text-field__input:focus,
.army .unity-base-popup-field__input:focus {
    border-color: var(--gold);
}

.army .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--gold);
}


/* слева колонка узкая — подпись над полем */
.army-left .unity-base-field {
    flex-direction: column;
    align-items: stretch;
}

.army-left .unity-base-field__label {
    min-width: 0;
    margin-bottom: 1px;
}

/* полосы прокрутки — тёмные, тонкие */
.army .unity-scroller--vertical {
    width: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.army .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: #15110b;
    border-width: 0;
}

.army .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--edge);
    border-width: 0;
    border-radius: 3px;
}

.army .unity-scroller__low-button,
.army .unity-scroller__high-button {
    display: none;
}
